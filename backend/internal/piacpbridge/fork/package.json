{
  "name": "@lumi-ai-lab/pi-acp-bridge",
  "version": "0.0.33-lumi.1",
  "description": "Lumi's auditable pi-acp bridge with session instruction transport",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lumi-ai-lab/lumi.git",
    "directory": "backend/internal/piacpbridge/fork"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/lumi-ai-lab/lumi/issues/3"
  },
  "homepage": "https://github.com/lumi-ai-lab/lumi/tree/main/backend/internal/piacpbridge/fork",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lumi-pi-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
